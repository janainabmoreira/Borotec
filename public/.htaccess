<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Pastas antigas que ainda existem fisicamente em /www. Ficam ANTES de
  # qualquer regra com "RewriteCond %{REQUEST_FILENAME} -d", para o 301 sair
  # mesmo com a pasta lá (e em um salto só, já para https sem www). Aceitam
  # com e sem barra final, e /index.html.
  RewriteRule ^categorias(/|/index\.html)?$ https://borotec.com.br/boroscopios/ [R=301,L]
  RewriteRule ^(camera-termografica-portatil|linha-d-camera-termografica-inspecao-eletrica)(/|/index\.html)?$ https://borotec.com.br/termografia/linha-d/inspecao-eletrica/ [R=301,L]
  # Linha P reorganizada (02/10/2026): o BT-8200 de visão dupla virou a versão
  # Compacta do BT-8300.
  RewriteRule ^linha-p/camera-inspecao-poco-artesiano-visao-dupla-bt-8200(/|/index\.html)?$ https://borotec.com.br/linha-p/camera-inspecao-poco-profundo-bt-8300/ [R=301,L]

  # Consolida em https://borotec.com.br (sem www) em um único salto.
  # Quando o destino é uma pasta sem barra final (toda rota pré-renderizada é
  # uma pasta), já redireciona com a barra — senão o mod_dir daria um segundo
  # 301 (http://www…/linha-t → https://…/linha-t → https://…/linha-t/).
  RewriteCond %{HTTPS} off [OR]
  RewriteCond %{HTTP_HOST} ^www\.borotec\.com\.br$ [NC]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^(.*[^/])$ https://borotec.com.br/$1/ [L,R=301]

  RewriteCond %{HTTPS} off [OR]
  RewriteCond %{HTTP_HOST} ^www\.borotec\.com\.br$ [NC]
  RewriteRule ^(.*)$ https://borotec.com.br/$1 [L,R=301]

  # NOTE: pedir uma pasta sem barra final (https://borotec.com.br/linha-t)
  # ainda gera o 301 do mod_dir para /linha-t/ — DirectorySlash Off dá 403
  # aqui (Options -Indexes). Os links do site já usam a barra final, então
  # isso só afeta URLs digitadas. Regras de REDIRECT deste arquivo rodam
  # antes desse 301 (visto em 10/11/2026: http://www…/linha-t recebeu o 301
  # da regra acima, não o do mod_dir).

  # URLs antigas (pré-migração para Supabase, confirmadas no Search Console)

  # /produtos e /tubulacoes (catálogo antigo e aliases de produto) não existem
  # mais: 410 Gone para tudo abaixo deles. Os produtos vivem em
  # /<linha>/<produto>/; os aliases também saíram do App.tsx (10/11/2026).
  RewriteRule ^(produtos|tubulacoes)(/.*)?$ - [G,L]

  # Bloqueia acesso a arquivos sensíveis
  RewriteRule ^\.env          - [F,L]
  RewriteRule ^\.git          - [F,L]
  RewriteRule ^\.htpasswd     - [F,L]
  RewriteRule ^composer\.(json|lock)$ - [F,L]
  RewriteRule ^package(-lock)?\.json$ - [F,L]

</IfModule>

# Rota sem pasta própria (não pré-renderizada) → 404 DE VERDADE, servindo o
# app-shell.html (HTML neutro com noindex, gerado pelo scripts/prerender.mjs).
# O React carrega mesmo assim: mostra a página "não encontrada", e rotas que
# só existem no navegador (/admin, /busca) continuam funcionando — só com
# status 404. Nunca usar o index.html aqui: é a home pré-renderizada, e
# servi-lo fazia toda rota sair com title/canonical da home (bug de 15/10).
ErrorDocument 404 /app-shell.html

# Bloqueia User-Agents de scanners/bots maliciosos comuns
<IfModule mod_setenvif.c>
  SetEnvIfNoCase User-Agent "sqlmap"        bad_bot
  SetEnvIfNoCase User-Agent "nikto"         bad_bot
  SetEnvIfNoCase User-Agent "masscan"       bad_bot
  SetEnvIfNoCase User-Agent "zgrab"         bad_bot
  SetEnvIfNoCase User-Agent "nuclei"        bad_bot
  SetEnvIfNoCase User-Agent "python-httpx"  bad_bot
  SetEnvIfNoCase User-Agent "python-urllib" bad_bot
  <RequireAll>
    Require all granted
    Require not env bad_bot
  </RequireAll>
</IfModule>

<IfModule mod_headers.c>
  # Segurança — cabeçalhos de proteção
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-XSS-Protection "1; mode=block"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"

  # Oculta versão do servidor
  Header always unset X-Powered-By
  Header always unset Server

  # HTML: sem cache — garante versão mais nova sempre
  <FilesMatch "\.html$">
    Header set Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </FilesMatch>

  # JS e CSS: cache de 1 hora
  <FilesMatch "\.(js|css)$">
    Header set Cache-Control "public, max-age=3600, must-revalidate"
  </FilesMatch>

  # Imagens e fontes: cache de 30 dias
  <FilesMatch "\.(webp|png|jpg|jpeg|svg|gif|ico|woff2|woff|ttf|mp4)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
</IfModule>

# Compressão gzip
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json
</IfModule>

# Bloqueia listagem de diretórios
Options -Indexes
