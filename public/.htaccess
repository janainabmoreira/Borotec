<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Consolida em https://borotec.com.br (sem www) em um único salto
  RewriteCond %{HTTPS} off [OR]
  RewriteCond %{HTTP_HOST} ^www\.borotec\.com\.br$ [NC]
  RewriteRule ^(.*)$ https://borotec.com.br/$1 [L,R=301]

  # NOTE: tried to avoid the trailing-slash redirect Apache does for
  # directory requests (every prerendered route is a real folder,
  # dist/linha-t/:id/index.html) — neither DirectorySlash Off (caused a 403,
  # since Options -Indexes then blocks the directory listing Apache falls
  # back to) nor an explicit RewriteRule to serve index.html directly worked:
  # on this host, mod_dir's redirect fires before .htaccess rewrite rules
  # ever get a chance to run for a request that maps to an existing
  # directory. Leaving this as Apache's default behavior — a single, clean
  # 301 to the trailing-slash URL isn't a real SEO problem (unlike the
  # canonical-always-points-home bug this project actually fixes), just not
  # perfectly optimized.

  # URLs antigas (pré-migração para Supabase, confirmadas no Search Console)

  # "/produtos" sem ID nunca foi uma rota válida (reportado como "erro de
  # redirecionamento" no GSC — 1 URL, 20/05/2026 em diante)
  RewriteRule ^produtos/?$ - [R=404,L]

  # Catálogo antigo (pré-Supabase) descontinuado — nenhum destes IDs existe no
  # catálogo atual (confirmado: 9 produtos ativos, todos com sufixo bt-*).
  # 14 destes já aparecem como "página com redirecionamento" no GSC; os outros
  # 9 (mesma origem: prerenderRoutes antigo / src/data/products.ts) ainda não
  # foram recrawleados nessa categoria, mas são igualmente órfãos.
  RewriteRule ^produtos/(sk3208|sk3210|sk3328|sk3408|sk3608|sk3610|sk3808|sk3828|y-series|dz-series|k-series-3d|k-series-ex|k-series-ht|k-series-thermal|k-series-uv|trolley-73mm|fb20p-camera|fb20p-tablet|fb20p-system|p-series|k-series|la-series|hj-series)/?$ - [G,L]

  # Bloqueia acesso a arquivos sensíveis
  RewriteRule ^\.env          - [F,L]
  RewriteRule ^\.git          - [F,L]
  RewriteRule ^\.htpasswd     - [F,L]
  RewriteRule ^composer\.(json|lock)$ - [F,L]
  RewriteRule ^package(-lock)?\.json$ - [F,L]

  # Rotas do React (SPA fallback)
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>

# Bloqueia User-Agents de scanners/bots maliciosos comuns
<IfModule mod_setenvif.c>
  SetEnvIfNoCase User-Agent "sqlmap"        bad_bot
  SetEnvIfNoCase User-Agent "nikto"         bad_bot
  SetEnvIfNoCase User-Agent "masscan"       bad_bot
  SetEnvIfNoCase User-Agent "zgrab"         bad_bot
  SetEnvIfNoCase User-Agent "nuclei"        bad_bot
  SetEnvIfNoCase User-Agent "python-httpx"  bad_bot
  SetEnvIfNoCase User-Agent "python-urllib" bad_bot
  <RequireAll>
    Require all granted
    Require not env bad_bot
  </RequireAll>
</IfModule>

<IfModule mod_headers.c>
  # Segurança — cabeçalhos de proteção
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-XSS-Protection "1; mode=block"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"

  # Oculta versão do servidor
  Header always unset X-Powered-By
  Header always unset Server

  # HTML: sem cache — garante versão mais nova sempre
  <FilesMatch "\.html$">
    Header set Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </FilesMatch>

  # JS e CSS: cache de 1 hora
  <FilesMatch "\.(js|css)$">
    Header set Cache-Control "public, max-age=3600, must-revalidate"
  </FilesMatch>

  # Imagens e fontes: cache de 30 dias
  <FilesMatch "\.(webp|png|jpg|jpeg|svg|gif|ico|woff2|woff|ttf|mp4)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
</IfModule>

# Compressão gzip
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json
</IfModule>

# Bloqueia listagem de diretórios
Options -Indexes
